# Optional but strongly recommended for official metadata, channel, and search APIs.
YOUTUBE_API_KEY=

# MCP transport: streamable-http for ChatGPT, stdio for local MCP clients.
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Disable only if policy forbids unofficial YouTube extraction.
YOUTUBE_ENABLE_YTDLP=true

# Default transcript page size and absolute per-request hard limit.
# Longer transcripts can be retrieved through pagination.
YOUTUBE_TRANSCRIPT_MAX_CHARS=60000
YOUTUBE_TRANSCRIPT_HARD_MAX_CHARS=120000
YOUTUBE_DEFAULT_LANGUAGES=de,en

# Optional staged yt-dlp self-updater (Phase 2). DEFAULT: auto-update OFF —
# the bundled yt-dlp shipped in the image is used. When enabled, a background
# thread downloads, SHA-256-verifies, and validates a candidate before
# atomically promoting it; failures are non-fatal and keep the current version.
YTDLP_AUTO_UPDATE=false
YTDLP_UPDATE_CHANNEL=stable        # stable (default) or nightly (opt-in)
YTDLP_UPDATE_INTERVAL=86400        # seconds between checks

# Persistent writable location for staged yt-dlp versions.
YTDLP_STATE_DIR=/app/state/ytdlp

# Run a tiny live YouTube smoke test before promoting (rate-limit caution).
YTDLP_UPDATE_SMOKE=false

# Video used for the optional smoke test above.
YTDLP_UPDATE_SMOKE_URL=https://www.youtube.com/watch?v=BaW1PyD2tbw

# ---------------------------------------------------------------- MCP edge
# Public Remote MCP edge (Stage 0/1): static Bearer auth + Streamable HTTP proxy
# to the private core above. Also used by: docker compose --profile edge up
EDGE_MCP_UPSTREAM_URL=http://youtube-mcp:8765/mcp
EDGE_HOST=127.0.0.1
EDGE_PORT=8766

# Static Bearer auth. Tokens are newline- and/or comma-separated; keep them
# strictly secret. NEVER put real tokens in this committed example file —
# copy .env.example to .env (which IS gitignored; compose reads .env) and
# place the real secrets there. Multiple tokens allow rotation (old + new
# during the transition). NEVER place real tokens in committed docs.
# With EDGE_STATIC_AUTH_ENABLED=true (default) and no tokens, the edge refuses
# to start (fail closed).
EDGE_STATIC_AUTH_ENABLED=true
EDGE_STATIC_TOKENS=

# Request-body size cap (bytes) enforced by the edge before any tool work.
EDGE_MAX_REQUEST_BYTES=2097152

# Upstream request timeout (seconds).
EDGE_UPSTREAM_TIMEOUT_SECONDS=120

# ---- Public HTTPS static-auth edge (Stage 2) --------------------------------
# Set BOTH of the following to make the edge terminate TLS itself (default
# packaged path). Leave both unset to run the edge on plain HTTP — e.g. local
# use, or behind an existing TLS-terminating ingress (Caddy/nginx/Traefik).
# Point them at PEM files readable inside the edge container:
#   * docker compose --profile edge-public up
#     uses EDGE_TLS_DIR (default ./edge-certs) mounted (read-only) into /certs,
#     so set these to /certs/tls.crt and /certs/tls.key.
# Setting exactly one of the two is a configuration error (fail closed).
EDGE_TLS_CERT_FILE=
EDGE_TLS_KEY_FILE=
# Directory (on the Compose host) mounted read-only into the edge container's
# /certs, holding the PEM cert chain and private key used above.
EDGE_TLS_DIR=./edge-certs
# Public HTTPS host port published by the edge-public profile.
EDGE_PUBLIC_HTTPS_PORT=8443
# Host bind address for that published port. Safe default: 127.0.0.1
# (loopback only — not reachable beyond this host). To make the edge genuinely
# public (the intended purpose once TLS + static/OAuth auth are configured),
# set this to 0.0.0.0 (or a specific interface) in .env. 0.0.0.0 is
# deliberately NOT the silent default; leaving this unset exposes only loopback.
EDGE_PUBLIC_BIND_ADDRESS=127.0.0.1
# Port the edge listens on inside its container (HTTP or HTTPS).
EDGE_PUBLIC_PORT=8766

# ---- OAuth Resource Server (Stage 3, optional) -------------------------------
# Lets OAuth-capable MCP clients (Claude, LibreChat) connect with access tokens
# issued by a separate Authorization Server. When disabled (default) the edge
# behaves exactly as static/local Stages 1–2. See docs/PUBLIC_MCP_EDGE_STAGE_3.md.
EDGE_OAUTH_ENABLED=false
# AS issuer URL (absolute http(s)). Required when EDGE_OAUTH_ENABLED=true.
EDGE_OAUTH_ISSUER=
# Optional explicit JWKS URL; leave empty to auto-discover from issuer metadata.
EDGE_OAUTH_JWKS_URL=
# Expected audience/resource identifier for access tokens (strict when set).
# Operators SHOULD set this to match the AS's token audience.
EDGE_OAUTH_AUDIENCE=
# Required scope every accepted access token must carry (else 403). Optional.
EDGE_OAUTH_REQUIRED_SCOPE=
# Accepted signature algorithms (asymmetric only). Default:
# RS256,RS384,RS512,ES256,ES384,ES512
EDGE_OAUTH_ALGORITHMS=RS256,RS384,RS512,ES256,ES384,ES512
# Clock-skew tolerance (seconds) for exp/nbf/iat.
EDGE_OAUTH_CLOCK_SKEW_SECONDS=5
# Public protected MCP URL (RFC 9728 `resource`). Required when enabled.
EDGE_OAUTH_RESOURCE_IDENTIFIER=https://mcp.example.org/mcp
# Optional override for the RFC 9728 metadata URL (else derived from the
# resource identifier origin).
EDGE_OAUTH_METADATA_URL=
# authorization_servers advertised in metadata (default = EDGE_OAUTH_ISSUER).
EDGE_OAUTH_AUTHORIZATION_SERVERS=
# scopes_supported advertised in metadata.
EDGE_OAUTH_SCOPES_SUPPORTED=
# Reserved static namespace prefix used for static-vs-OAuth dispatch.
EDGE_STATIC_TOKEN_PREFIX=ytsk_
