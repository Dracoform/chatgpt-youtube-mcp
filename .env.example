# Optional but strongly recommended for official metadata, channel, and search APIs.
YOUTUBE_API_KEY=

# MCP transport: streamable-http for ChatGPT, stdio for local MCP clients.
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Disable only if policy forbids unofficial YouTube extraction.
YOUTUBE_ENABLE_YTDLP=true

# Default transcript page size and absolute per-request hard limit.
# Longer transcripts can be retrieved through pagination.
YOUTUBE_TRANSCRIPT_MAX_CHARS=60000
YOUTUBE_TRANSCRIPT_HARD_MAX_CHARS=120000
YOUTUBE_DEFAULT_LANGUAGES=de,en

# Optional staged yt-dlp self-updater (Phase 2). DEFAULT: auto-update OFF —
# the bundled yt-dlp shipped in the image is used. When enabled, a background
# thread downloads, SHA-256-verifies, and validates a candidate before
# atomically promoting it; failures are non-fatal and keep the current version.
YTDLP_AUTO_UPDATE=false
YTDLP_UPDATE_CHANNEL=stable        # stable (default) or nightly (opt-in)
YTDLP_UPDATE_INTERVAL=86400        # seconds between checks

# Persistent writable location for staged yt-dlp versions.
YTDLP_STATE_DIR=/app/state/ytdlp

# Run a tiny live YouTube smoke test before promoting (rate-limit caution).
YTDLP_UPDATE_SMOKE=false

# Video used for the optional smoke test above.
YTDLP_UPDATE_SMOKE_URL=https://www.youtube.com/watch?v=BaW1PyD2tbw

# ---------------------------------------------------------------- MCP edge
# Public Remote MCP edge (Stage 0/1): static Bearer auth + Streamable HTTP proxy
# to the private core above. Also used by: docker compose --profile edge up
EDGE_MCP_UPSTREAM_URL=http://youtube-mcp:8765/mcp
EDGE_HOST=127.0.0.1
EDGE_PORT=8766

# Static Bearer auth. Tokens are newline- and/or comma-separated; keep them
# strictly secret (this file is gitignored). Multiple tokens allow rotation
# (old + new during the transition). NEVER place real tokens in committed docs.
# With EDGE_STATIC_AUTH_ENABLED=true (default) and no tokens, the edge refuses
# to start (fail closed).
EDGE_STATIC_AUTH_ENABLED=true
EDGE_STATIC_TOKENS=

# Request-body size cap (bytes) enforced by the edge before any tool work.
EDGE_MAX_REQUEST_BYTES=2097152

# Upstream request timeout (seconds).
EDGE_UPSTREAM_TIMEOUT_SECONDS=120
